{
  "name": "fb-saved-dl",
  "version": "0.1.0",
  "description": "CLI to download Facebook saved videos",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "fb-saved-dl": "./bin/fb-saved-dl.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:sea": "node build-sea.mjs",
    "frontend:check": "tsc --noEmit -p tsconfig.frontend.json",
    "frontend:build": "node build-frontend.mjs",
    "tauri": "tauri",
    "tauri:dev": "npm run frontend:build && tauri dev --target x86_64-pc-windows-msvc",
    "tauri:build": "npm run frontend:build && tauri build --target x86_64-pc-windows-msvc",
    "dev": "tsx src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "playwright": "^1.59.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^20.14.0",
    "esbuild": "^0.23.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "files": [
    "dist",
    "bin"
  ]
}
